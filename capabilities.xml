<?xml version="1.0" encoding="UTF-8"?>
<!--
Pixel -Metadata- (RetroPie port)
Original by Eric Hettervik (RetroPie Pixel -Metadata- v1.4)
Modern ES-DE 7+ conversion: capabilities + variants + override triggers
-->
<themeCapabilities>
    <themeName>Pixel</themeName>

    <aspectRatio>16:9</aspectRatio>
    <aspectRatio>16:10</aspectRatio>
    <aspectRatio>4:3</aspectRatio>

    <variant name="textlistWithVideos">
        <label>Textlist with videos</label>
        <selectable>true</selectable>
        <override>
            <trigger>noVideos</trigger>
            <useVariant>textlistWithImages</useVariant>
        </override>
        <override>
            <trigger>noMedia</trigger>
            <mediaType>miximage, screenshot, titlescreen, cover, video</mediaType>
            <useVariant>textlistBasic</useVariant>
        </override>
    </variant>

    <variant name="textlistWithImages">
        <label>Textlist with images</label>
        <selectable>true</selectable>
        <override>
            <trigger>noMedia</trigger>
            <mediaType>miximage, screenshot, titlescreen, cover</mediaType>
            <useVariant>textlistBasic</useVariant>
        </override>
    </variant>

    <variant name="textlistBasic">
        <label>Textlist basic</label>
        <selectable>true</selectable>
    </variant>
</themeCapabilities>
